{
  "name": "@mova/api",
  "version": "0.1.0",
  "private": true,
  "description": "Mova API — TypeScript Vercel Functions (auth verification, validation, Groq orchestration, domain writes).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=.env --import tsx src/devServer.ts",
    "verify:live": "node --env-file=.env --import tsx src/dev/verifyLiveIsolation.ts"
  },
  "dependencies": {
    "@mova/engine": "*",
    "@mova/shared": "*",
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
