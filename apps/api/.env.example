# Server-side configuration for the Mova API (Vercel project, Root Directory = apps/api).
# Copy to .env for local development. NEVER commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon key — used together with each user's JWT so RLS applies.
# Not a secret, but never treated as authorization on its own.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Groq (OpenAI-compatible API) — SECRET, server only. Never expose it to the app or commit it.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated client origins allowed by CORS (web builds / Expo web).
APP_ORIGIN=http://localhost:8081
API_ENV=development
