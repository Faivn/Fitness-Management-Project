# Public client configuration only. These values are compiled into the app
# bundle, so NEVER put the Supabase service-role key or the Groq API key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Base URL of the Mova API (Vercel). For local development: http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
